{
  "name": "chimera",
  "version": "0.1.0",
  "description": "An agent bridge on Cloudflare Workers: messages, tasks, status and device sessions for MCP clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funtime-design/chimera.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build:responder": "node bin/build-responder.mjs",
    "pretest": "node bin/test-guard.mjs && pnpm build:responder",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "deploy": "wrangler deploy",
    "test:engine": "node test/harness/setup.mjs",
    "secrets:push": "node bin/secrets-push.mjs",
    "secrets:mint": "node bin/secrets-mint.mjs",
    "secrets:fill": "node bin/secrets-fill.mjs",
    "access:provision": "node bin/access-provision.mjs",
    "members:sync": "node bin/access-provision.mjs --sync",
    "gen:wrangler": "node bin/gen-wrangler.mjs",
    "validate:deployment": "node bin/validate-deployment.mjs",
    "contract:check": "node bin/contract-check.mjs",
    "setup": "node bin/setup.mjs",
    "staging:smoke": "node bin/staging-smoke.mjs",
    "release:tag": "node bin/release-tag.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1"
  }
}
