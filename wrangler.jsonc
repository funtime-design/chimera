// Local development only. Deploys use the generated .generated/wrangler.<id>.jsonc (pnpm gen:wrangler), which carries
// the deployment's Worker name, route and account ID. The build step points src/config/deployment.ts at
// deployments/$CHIMERA_DEPLOYMENT (default "example").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chimera",
  "main": "src/index.ts",
  "build": {
    "command": "node bin/selected-deployment.mjs"
  },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "GOONBRIDGE_CLAIM_SECONDS": "4500",
    "ACCESS_PAGES_ISSUER": "",
    "ACCESS_PAGES_AUD": ""
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md",
        "**/*.mjs",
        "**/*.sh"
      ],
      "fallthrough": true
    }
  ]
}
