{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private deployment secrets",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "GOONBRIDGE_TOKENS": {
      "description": "Member name to token; push converts to the legacy token-to-member JSON map.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "not": {
          "const": "all"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 24,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "ACCESS_CLIENT_SECRET": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "GOONBRIDGE_GITHUB_WEBHOOK_SECRET": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "GOONBRIDGE_ROUTINES": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "not": {
          "const": "all"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "required": [
          "trigger",
          "token"
        ],
        "additionalProperties": false
      }
    },
    "GITHUB_CONFIG_PAT": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "GOONBRIDGE_MEMBERS": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "email"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "not": {
          "const": "all"
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        }
      },
      "required": [
        "accountId"
      ],
      "additionalProperties": false
    },
    "CLOUDFLARE_API_TOKEN": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "contractToken": {
      "type": "string",
      "minLength": 1,
      "description": "Member name whose existing static token is used by the post-deploy contract check."
    }
  },
  "patternProperties": {
    "^GOONBRIDGE_ROUTINE_[A-Z0-9]+_(TRIGGER|TOKEN)$": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  },
  "required": [
    "GOONBRIDGE_TOKENS",
    "cloudflare",
    "CLOUDFLARE_API_TOKEN",
    "contractToken"
  ]
}
